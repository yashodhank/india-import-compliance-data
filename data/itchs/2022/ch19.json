 "chapter_conditions": [
  {
   "chapter": "19",
   "note_type": "Main",
   "serial_no": "1",
   "section": "IV",
   "text": "This Chapter does not cover : (a) except in the case of stuffed products of heading 1902, food preparations containing more than 20% by weight of sausage, meat, meat offal, blood, insect, fish or crustaceans, molluscs or other aquaticinvertebrates, or any combination thereof (Chapter 16); (b) biscuits or other articles made from flour or from starch, specially prepared for use in animal feeding (heading 2309); or (c) medicaments or other products of Chapter 30.",
   "notification_no": "Notification No. 54/2015-2020",
   "notification_date": "2009-01-20",
   "as_of": "2026-10-22"
  },
  {
   "chapter": "19",
   "note_type": "Main",
   "serial_no": "2",
   "section": "IV",
   "text": "For the purposes of heading 1901: (a) the term \"\"groats\"\" means cereal groats of Chapter 11; (b) the terms \"\"flour\"\" and \"\"meal\"\" means : (1) cereal flour and meal of Chapter 11, and (2) flour, meal and powder of vegetable origin of any Chapter, other than flour, meal or powder of dried vegetables (heading 0712), of potatoes (heading 1105) or of dried leguminous vegetables (heading 1106).",
   "notification_no": "",
   "notification_date": "",
   "as_of": "2026-10-22"
  },
  {
   "chapter": "19",
   "note_type": "Main",
   "serial_no": "3",
   "section": "IV",
   "text": "Heading 1904 does not cover preparations containing more than 6% by weight of cocoa calculated on a totally defatted basis or completely coated with chocolate or other food preparations containing cocoa of heading 1806 (heading 1806).",
   "notification_no": "",
   "notification_date": "",
   "as_of": "2026-10-22"
  },
  {
   "chapter": "19",
   "note_type": "Main",
   "serial_no": "4",
   "section": "IV",
   "text": "For the purposes of heading 1904, the expression \"otherwise prepared\" means prepared or processed to an extent beyond that provided for in the headings of, or Notes to, Chapter 10 or 11.",
   "notification_no": "",
   "notification_date": "",
   "as_of": "2026-10-22"
  },
  {
   "chapter": "19",
   "note_type": "Policy Condition",
   "serial_no": "1",
   "section": "IV",
   "text": "Prohibition on import of milk and milk products (including chocolates and chocolate products and candies/ confectionary/ food preparations with milk or milk solids as an ingredient) from China is extended until the capacity of all laboratories at ports of entry have been suitably upgraded for testing melamine.",
   "notification_no": "",
   "notification_date": "",
   "as_of": "2026-10-22"
  }
 ]
}
