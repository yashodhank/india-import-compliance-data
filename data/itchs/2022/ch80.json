 "chapter_conditions": [
  {
   "chapter": "80",
   "note_type": "Sub-Heading",
   "serial_no": "1",
   "section": "XV",
   "text": "In this Chapter, the following expressions have the meanings hereby assigned to them: (a) Tin, not alloyed Metal containing by weight at least 99% of tin, provided that the content by weight of any bismuth or copper is less than the limit specified in the following Table: TABLE – OTHER ELEMENTS Element Limiting content % by weight Bi BISMUTH 0.1 Cu COPPER 0.4 (b) Tin alloys Metallic substances in which tin predominates by weight over each of the other elements, provided that: (i) the total content by weight of such other elements exceeds 1%; or (ii) the content by weight of either bismuth or copper is equal to or greater than the limit specified in the foregoing table",
   "notification_no": "",
   "notification_date": "",
   "as_of": "2026-10-22"
  }
 ]
