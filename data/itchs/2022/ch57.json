 "chapter_conditions": [
  {
   "chapter": "57",
   "note_type": "Main",
   "serial_no": "1",
   "section": "XI",
   "text": "For the purposes of this Chapter, the term \"carpets and other textile floor coverings\" means floor coverings in which textile materials serve as the exposed surface of the article when in use and includes articles having the characteristics of textile floor coverings but intended for use for other purposes.",
   "notification_no": "",
   "notification_date": "",
   "as_of": "2026-10-22"
  },
  {
   "chapter": "57",
   "note_type": "Main",
   "serial_no": "2",
   "section": "XI",
   "text": "This Chapter does not cover floor covering underlays.",
   "notification_no": "",
   "notification_date": "",
   "as_of": "2026-10-22"
  },
  {
   "chapter": "57",
   "note_type": "Supplementary Notes",
   "serial_no": "1",
   "section": "XI",
   "text": "For the purposes of tariff items 5703 29 22, 5703 39 31, 5703 39 32, 5703 39 33 and 5703 39 39, the term “Special Finishes” means process of making the product with any one or more of the following properties such as fire resistant, fire retardant, chemical resistant, anti-static, dust resistant, anti-stain, anti-microbial, anti-odor, UV stabilized, heat resistant, etc.’;",
   "notification_no": "40/2024-25",
   "notification_date": "2024-11-26",
   "as_of": "2026-10-22"
  }
