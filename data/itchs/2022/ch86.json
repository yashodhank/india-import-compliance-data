 "chapter_conditions": [
  {
   "chapter": "86",
   "note_type": "Main",
   "serial_no": "1",
   "section": "XVII",
   "text": "This Chapter does not cover : (a) railway or tramway sleepers of wood or of concrete, or concrete guide-track sections for hovertrains (heading 4406 or 6810); (b) railway or tramway track construction material of iron or steel of heading 7302; or (c) electrical signalling, safety or traffic control equipment of heading 8530.",
   "notification_no": "Notification No. 54/2015-2020",
   "notification_date": "2022-02-09",
   "as_of": "2026-10-22"
  },
  {
   "chapter": "86",
   "note_type": "Main",
   "serial_no": "2",
   "section": "XVII",
   "text": "Heading 8607 applies, inter alia, to: (a) axles, wheels, wheel sets (running gear), metal tyres, hoops and hubs and other parts of wheels; (b) frames, under frames, bogies and bissel-bogies; (c) axle boxes, brake gear; (d) buffers for rolling-stock; hooks and other coupling gear and corridor connections; (e) coachwork.",
   "notification_no": "Notification No. 54/2015-2020",
   "notification_date": "2022-02-09",
   "as_of": "2026-10-22"
  },
  {
   "chapter": "86",
   "note_type": "Main",
   "serial_no": "3",
   "section": "XVII",
   "text": "Subject to the provisions of Note 1 above, heading 8608 applies, inter alia, to : (a) assembled track, turntables, platform buffers, loading gauges; (b) semaphores, mechanical signal discs, level crossing control gear, signal and point controls and other mechanical (including electro-mechanical) signalling, safety or traffic control equipment, whether or not fitted for electric lighting, for railways, tramways, roads, inland waterways, parking facilities, port installations or airfields.",
   "notification_no": "Notification No. 54/2015-2020",
   "notification_date": "2022-02-09",
   "as_of": "2026-10-22"
  },
  {
   "chapter": "86",
   "note_type": "Policy Condition",
   "serial_no": "1",
   "section": "XVII",
   "text": "The Exim entry under ITC (HS) Code No. 86090000 in this Chapter shall also include second hand marine containers and imports thereof shall be free.",
   "notification_no": "",
   "notification_date": "",
   "as_of": "2026-10-22"
  },
  {
   "chapter": "86",
   "note_type": "Policy Condition",
   "serial_no": "2",
   "section": "XVII",
   "text": "Import under all the HS codes of this Chapter shall require compulsory registration under Steel Import Monitoring System (SIMS).",
   "notification_no": "33/2015-2020",
   "notification_date": "2020-09-28",
   "as_of": "2026-10-22"
  },
  {
   "chapter": "86",
   "note_type": "Policy Condition",
   "serial_no": "3",
   "section": "XVII",
   "text": "(a) Items: As per the Annex. (b) Policy Condition to Chapter 72, 73 and 86 of ITC (HS): Import Policy for the items as listed in the Annex has been revised from free to free subject to compulsory registration under Steel Import Monitoring System (SIMS). (c) The Steel Importing Monitoring System (SIMS) shall require importers to submit advance information in an online system for import of items and obtain an automatic Registration Number by paying registration fee as per Appendix 2K. The importer can apply for registration not earlier than 60th day before the expected date of arrival of import consignment. The automatic Registration Number thus granted shall remain valid for a period of 75 days. (d) Importer shall have to enter the Registration Number and expiry date of Registration in the Bill of Entry to enable Customs for clearance of consignment. (e) The SIMS will be effective from 21.11.2019, i.e. Bill of Entry on or after 21.11.2019 for items listed in the Annex to this Notification shall be governed by SIMS.",
   "notification_no": "04/2025-26",
   "notification_date": "2025-04-15",
   "as_of": "2026-10-22"
  }
 ]
