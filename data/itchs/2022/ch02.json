 "chapter_conditions": [
  {
   "chapter": "02",
   "note_type": "Main",
   "serial_no": "1",
   "section": "I",
   "text": "This Chapter does not cover : (a) products of the kinds described in headings 0201 to 0208 or 0210, unfit or unsuitable for human consumption; (b) edible, non-living insects (heading 0410); (c) guts, bladders or stomachs of animals (heading 0504) or animal blood (heading 0511 or 3002); or (d) animal fat, other than products of heading 0209 (Chapter 15).",
   "notification_no": "Notification No. 54/2015-2020",
   "notification_date": "2022-02-09",
   "as_of": "2026-10-22"
  },
  {
   "chapter": "02",
   "note_type": "Supplementary Notes",
   "serial_no": "1",
   "section": "I",
   "text": "In this Chapter wild animals means wild animals as defined in Wildlife (Protection) Act, 1972 (53 of 1972).",
   "notification_no": "",
   "notification_date": "",
   "as_of": "2026-10-22"
  },
  {
   "chapter": "02",
   "note_type": "Policy Condition",
   "serial_no": "1",
   "section": "I",
   "text": "An application for grant of a licence for import of Animals, Birds and Reptiles (including their parts and products) may be made in the ANF 2M of Appendices and Aayat Niryat Forms of FTP (2015-20) to the Director General of Foreign Trade alongwith the recommendation of the Chief Wild Life Warden of the State concerned.",
   "notification_no": "",
   "notification_date": "",
   "as_of": "2026-10-22"
  },
  {
   "chapter": "02",
   "note_type": "Policy Condition",
   "serial_no": "2",
   "section": "I",
   "text": "Import of wild animals (including their parts and products) as defined in the Wildlife (Protection) Act, 1972 (as amended from time to time) is prohibited and those species which are listed in CITES are subject to the provisions of CITES.",
   "notification_no": "",
   "notification_date": "",
   "as_of": "2026-10-22"
  },
  {
   "chapter": "02",
   "note_type": "Policy Condition",
   "serial_no": "3",
   "section": "I",
   "text": "Import of all live-stock products shall be subject to a sanitary import permit to be issued by Department of Animal Husbandry, Dairying and Fisheries, Government of India, as per Section 3A of Live-stock Importation Act, 1898, as incorporated by Live Stock Importation (Amendment) Act, 2001 (Act No. 28 of 2001, 29th August, 2001), or as amended from time to time.",
   "notification_no": "",
   "notification_date": "",
   "as_of": "2026-10-22"
