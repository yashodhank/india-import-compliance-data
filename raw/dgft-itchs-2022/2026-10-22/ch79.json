{"itchsRODTEPDtlsDTO":null,"notes":[{"noteId":3.33000284E8,"noteName":"Sub-Heading","noteDetails":[{"notetype":"Sub-Heading","policyType":"IMPORT","chapter":"79","noteSerialNo":"1","notes":"<p style=\"text-align:justify\">In this Chapter, the following expressions have the meanings hereby assigned to them:</p>\n\n<p style=\"text-align:justify\">(a) Zinc, not alloyed Metal containing by weight at least 97.5% of Zinc.</p>\n\n<p style=\"text-align:justify\">(b) Zinc alloys Metallic substances in which zinc predominates by weight over each of the other elements, provided that the total content by weight of such other elements exceeds 2.5%.</p>\n\n<p style=\"text-align:justify\">(c) Zinc dust Dust obtained by condensation of zinc vapour, consisting of spherical particles which are finer than zinc powders. At least 80% by weight of the particles pass through a sieve with 63 micrometres (microns) mesh. It must contain at least 85% by weight of metallic zinc.</p>\n","notificationNo":null,"notificationDate":null,"noteSection":"XV"}],"noteSectionDetails":[]},{"noteId":3.33000286E8,"noteName":"Policy Condition","noteDetails":[{"notetype":"Policy Condition","policyType":"IMPORT","chapter":"79","noteSerialNo":"1","notes":"Import of the following kinds of zinc skimmings is permitted freely without an import licence to units registered with Ministry of Environment and Forest, Government of India, on actual user basis upto the annual quantity limits indicated in the registration certificate: \r\n\r\n(i) Zinc skimmings containing zinc 65percent and above, lead and cadmium less than 1.25percent and 0.1percent respectively.","notificationNo":"","notificationDate":"","noteSection":"XV"}],"noteSectionDetails":[]}],"itcCodeClassifications":[{"itcCodeId":null,"unitOfMeasure":null,"itcCode":"7901","itcDescription":"Unwrought zinc.","itchswco":"","impPolicy":"","impItcCodeType":"YES","impCondition":"","expPolicy":null,"expItcCodeType":null,"expCondition":null,"notificationNo":"","notificati