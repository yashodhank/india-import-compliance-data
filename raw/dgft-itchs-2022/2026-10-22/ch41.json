{"itchsRODTEPDtlsDTO":null,"notes":[{"noteId":3.33000283E8,"noteName":"Main","noteDetails":[{"notetype":"Main","policyType":"IMPORT","chapter":"41","noteSerialNo":"1","notes":"<p style=\"text-align:justify\">This Chapter does not cover:</p>\n\n<p style=\"text-align:justify\">(a) parings or similar waste, of raw hides or skins (heading 0511);</p>\n\n<p style=\"text-align:justify\">(b) bird skins or parts of bird skins, with their feathers or down, of heading 0505 or 6701; or</p>\n\n<p style=\"text-align:justify\">(c) hides or skins, with the hair or wool on, raw, tanned or dressed (Chapter 43); the following are, however, to be classified in Chapter 41, namely:</p>\n\n<p style=\"text-align:justify\">raw hides and skins, with the hair or wool on, of bovine animals(including buffalo), of equine animals, ofsheep or lambs (except Astrakhan, Broadtail, Caracul, Persian, or similar lambs, Indian, Chinese, Mongolian or Tibetan lambs), of goats or kids(except Yemen, Mongolian or Tibetan goats and Kids), of swine (including peccary), of chamois, of gazelle, of camels (including dromedaries) of reindeer, of elk, of deer, of roebucks or of dogs.</p>\n","notificationNo":null,"notificationDate":null,"noteSection":"VIII"},{"notetype":"Main","policyType":"IMPORT","chapter":"41","noteSerialNo":"2","notes":"<p>(A) Headings 4104 to 4106 do not cover hides and skins which have undergone a tanning (including pre-tanning) process which is reversible (headings 4101 to 4103, as the case may be).</p>\n\n<p>(B) For the purposes of headings 4104 to 4106, the term &quot;&quot;crust&quot;&quot; includes hides and skins that have been retanned, coloured or fat-liquored (stuffed) prior to drying.</p>\n","notificationNo":null,"notificationDate":null,"noteSection":"VIII"},{"notetype":"Main","policyType":"IMPORT","chapter":"41","noteSerialNo":"3","notes":"Throughout this Schedule, the expression \"composition leather\" means only substances of the kind referred to in heading 4115.","notificationNo":"","notificationDate":"","noteSection":"VIII"}],"noteSectionDetails":[]},{"noteId":3.33000286E8,"noteName":"Policy Condition","noteDetails":[{"notetype":"Policy Condition","policyType":"IMPORT","chapter":"41","noteSerialNo":"1","notes":"(1) Import of wild animals (including their parts and products) as defined in the Wildlife (Protection) Act, 1972 (as amended from time to time) is prohibited and in respect of those species listed in CITES, is subject to the provisions of CITES.","notificationNo":"","notificationDate":"","noteSection":"VIII"},{"notetype":"Policy Condition","policyType":"IMPORT","chapter":"41","noteSerialNo":"2","notes":"Import of all live-stock products covered in this Chapter shall be subject to the provisions of Notification No. S.O. 794(E) dated 28.3.2008.","notificationNo":"","notificationDate":"","noteSection":"VIII"},{"notetype":"Policy Condition","policyType":"IMPORT","chapter":"41","noteSerialNo":"3","notes":"Import of seal skin, in any form, is prohibited.","notificationNo":"","notificationDate":"","noteSection":"VIII"},{"notetype":"Policy Condition","policyType":"IMPORT","chapter":"41","noteSerialNo":"4","notes":"\"Imports are subject to compliance with the health protocol for import of hides and skin or sanitary conditions as may be prescribed from time to time by Department of Animal Husbandry and Dairying.\"","notificationNo":"55/2015-2020","notificationDate":"01.07.2021","noteSection":"VIII"}],"noteSectionDetails":[]}],"itcCodeClassifications":[{"itcCodeId":null,"unitOfMeasure":null,"itcCode":"4101","itcDescription":"Raw hides and skins of bovine (including buffalo) or equine animals (fresh, or salted, dried, limed, pickled or otherwise preserved, but not tanned, parchment-dressed or further prepared), whether or not dehaired or split.","itchswco":"","impPolicy":"","impItcCodeType":"YES","impCondition":"","expPolicy":null,"expItcCodeType":null,"expCondition":null,"notificationNo":"","notificationDate":""},{"itcCodeId":null,"unitOfMeasu